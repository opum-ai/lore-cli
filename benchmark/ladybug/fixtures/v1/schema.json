{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ladybug-benchmark-fixture/1",
  "title": "Lore Ladybug benchmark fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "seed", "counts", "coverage", "expected"],
  "properties": {
    "schema": { "const": "ladybug-benchmark-fixture/1" },
    "name": { "enum": ["small", "large"] },
    "seed": { "type": "integer", "minimum": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "tasks", "authoredEdges", "markdownBodyBytes"],
      "properties": {
        "concepts": { "type": "integer", "minimum": 1 },
        "tasks": { "type": "integer", "minimum": 1 },
        "authoredEdges": { "type": "integer", "minimum": 1 },
        "markdownBodyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphShapes", "graphDepths", "contextBudgets", "queries", "unicode", "additiveFields"],
      "properties": {
        "graphShapes": {
          "const": ["chain", "star", "cycle", "duplicate", "dangling"]
        },
        "graphDepths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "contextBudgets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "queries": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "class", "expectedMatches"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "class": { "enum": ["common", "rare", "tied", "no-hit", "unicode"] },
              "expectedMatches": { "type": "integer", "minimum": 0 },
              "expectTopTie": { "type": "boolean" }
            }
          }
        },
        "unicode": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "additiveFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalExportSha256", "sourceInventorySha256", "taskSnapshotSha256"],
      "properties": {
        "canonicalExportSha256": { "$ref": "#/$defs/sha256" },
        "sourceInventorySha256": { "$ref": "#/$defs/sha256" },
        "taskSnapshotSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
