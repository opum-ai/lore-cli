# Normalize all text files to LF in the index and on checkout — matches
# .editorconfig (end_of_line = lf) and Biome's formatter, and prevents Windows
# CI runners (core.autocrlf=true) from checking out CRLF and breaking `bun run lint`.
* text=auto eol=lf

# Binary assets: never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# docs/log.md is append-only and regenerated from git history by `lore sync`
# (DEC-180 (4)). A union merge keeps both branches' appended entries instead of
# conflicting; the following sync de-duplicates and orders them.
docs/log.md merge=union
