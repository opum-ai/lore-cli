{
  "name": "@opum-ai/lore",
  "version": "0.4.2",
  "author": "Jeremy Newhouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/lore-cli.git"
  },
  "devDependencies": {
    "@ladybugdb/core": "0.19.0",
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.3.14",
    "@types/mdast": "4.0.4",
    "commander": "15.0.0",
    "github-slugger": "2.0.0",
    "ipaddr.js": "2.4.0",
    "js-yaml": "5.2.2",
    "mdast-util-from-markdown": "2.0.3",
    "string-width": "8.2.2",
    "typescript": "^5",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@opum-ai/lore-darwin-arm64": "0.4.2",
    "@opum-ai/lore-darwin-x64": "0.4.2",
    "@opum-ai/lore-linux-arm64": "0.4.2",
    "@opum-ai/lore-linux-x64": "0.4.2",
    "@opum-ai/lore-win32-arm64": "0.4.2",
    "@opum-ai/lore-win32-x64": "0.4.2"
  },
  "bin": {
    "lore": "bin/lore.cjs"
  },
  "description": "Thin, OKF-native documentation CLI that couples repo-resident docs to Backlog.md and serves them to agents and humans.",
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@ladybugdb/core@0.19.0": "patches/@ladybugdb%2Fcore@0.19.0.patch"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lore": "bun run src/cli.ts",
    "build": "bun build --compile src/compiled.ts --outfile dist/lore",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:coverage": "bun test --coverage"
  },
  "trustedDependencies": [
    "@ladybugdb/core"
  ],
  "type": "module"
}
