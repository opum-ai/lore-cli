{
  "name": "@opum-ai/lore",
  "version": "0.0.0",
  "description": "Thin, OKF-native documentation CLI that couples repo-resident docs to Backlog.md and serves them to agents and humans.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "lore": "src/cli.ts"
  },
  "license": "MIT",
  "author": "Jeremy Newhouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/lore-cli.git"
  },
  "packageManager": "bun@1.2.23",
  "engines": {
    "bun": ">=1.2.23"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@opum-ai/lore-darwin-arm64": "0.0.0",
    "@opum-ai/lore-darwin-x64": "0.0.0",
    "@opum-ai/lore-linux-arm64": "0.0.0",
    "@opum-ai/lore-linux-x64": "0.0.0",
    "@opum-ai/lore-win32-x64": "0.0.0"
  },
  "scripts": {
    "lore": "bun run src/cli.ts",
    "build": "bun build --compile src/cli.ts --outfile dist/lore",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.2.23",
    "@types/mdast": "4.0.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@ladybugdb/core": "0.19.0",
    "commander": "15.0.0",
    "github-slugger": "2.0.0",
    "ipaddr.js": "2.4.0",
    "js-yaml": "5.2.2",
    "mdast-util-from-markdown": "2.0.3",
    "string-width": "8.2.2",
    "zod": "4.4.3"
  },
  "trustedDependencies": [
    "@ladybugdb/core"
  ]
}
