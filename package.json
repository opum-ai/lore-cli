{
  "name": "@salient-data/lore",
  "version": "0.0.0",
  "description": "Thin, OKF-native documentation CLI that couples repo-resident docs to Backlog.md and serves them to agents and humans.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "lore": "src/cli.ts"
  },
  "license": "MIT",
  "author": "Jeremy Newhouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-newhouse/lore.git"
  },
  "packageManager": "bun@1.2.23",
  "engines": {
    "bun": ">=1.2.23"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lore": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "^1.2.23",
    "@types/js-yaml": "4.0.9",
    "@types/mdast": "4.0.4",
    "typescript": "^5"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "js-yaml": "4.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "zod": "4.4.3"
  }
}
