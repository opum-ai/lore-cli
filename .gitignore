# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Per-platform compiled binaries (release build artifacts — LORE-9). Only the
# npm/<platform>/package.json templates are committed; the release workflow
# builds and places the actual binary at npm/<platform>/bin/lore[.exe].
npm/*/bin/
# npm pack output from release.yml's package job (or a local reproduction of it).
dist-npm/

# Test / coverage
coverage/
.nyc_output/

# Docker E2E harness output (LORE-56) — the Dockerfile/compose/script are
# committed; each run's report is generated, not durable.
docker/e2e/results/*
!docker/e2e/results/.gitkeep

# lore CLI state (config.toml and sync-state.json ARE committed; cache is not)
.lore/cache/

# Backlog.md transient lockfiles
backlog/.locks/

# Rendered-docs build output (configs are committed; build artifacts are not)
site/
website/build/
.docusaurus/

# Obsidian per-user vault state (commit docs/.obsidian/app.json only). Exclude-all-except,
# not an enumerated list of known files (workspace.json, appearance.json, core-plugins.json,
# hotkeys.json, graph.json, plugins/, snippets/, cache/, ...) -- Obsidian creates more of these
# than any fixed list can keep up with, confirmed by a real vault open against this repo's docs/.
docs/.obsidian/*
!docs/.obsidian/app.json

# Secrets / env
.env
.env.*
!.env.example

# Claude Code session-continuity runtime artifacts (handover/recovery loop).
# The skill (.claude/skills/), hooks (.claude/hooks/), and committed settings
# (.claude/settings.json) ARE tracked; these per-session files are NOT.
# Consumed handovers in archive/handovers/ ARE tracked for history.
.claude/handovers/
.checkpoint
.claude/session-errors.jsonl
.claude/error-history.jsonl
.claude/settings.local.json
.claude/sessions/
.claude/.session-id

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
