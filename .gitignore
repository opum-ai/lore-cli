# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Native and compiled binary artifacts. Source launchers and package templates
# remain tracked; these patterns cover locally produced executables/libraries.
*.exe
*.dll
*.dylib
*.so
*.node
*.wasm

# Per-platform compiled binaries (release build artifacts — LCLI-9). Only the
# npm/<platform>/package.json templates are committed; the release workflow
# builds and places the actual binary at npm/<platform>/bin/lore[.exe].
npm/*/bin/
# npm pack output from release.yml's package job (or a local reproduction of it).
dist-npm/

# Test / coverage
coverage/
.nyc_output/

# Local investigation/onboarding scratch retained outside the shipped CLI.
.repro-scratch/
lore-e2e-test.sh
lore-setup.sh

# Docker E2E harness output (LCLI-56) — the Dockerfile/compose/script are
# committed; each run's report is generated, not durable.
docker/e2e/results/*
!docker/e2e/results/.gitkeep

# lore CLI state (config.toml and sync-state.json ARE committed; generated state is not)
.lore/cache/
.lore/explorer/

# Rendered-docs build output (configs are committed; build artifacts are not)
site/
website/build/
.docusaurus/

# Obsidian per-user vault state (commit docs/.obsidian/app.json only). Exclude-all-except,
# not an enumerated list of known files (workspace.json, appearance.json, core-plugins.json,
# hotkeys.json, graph.json, plugins/, snippets/, cache/, ...) -- Obsidian creates more of these
# than any fixed list can keep up with, confirmed by a real vault open against this repo's docs/.
docs/.obsidian/*
!docs/.obsidian/app.json

# Secrets / env
.env
.env.*
!.env.example

# Claude Code session-continuity runtime artifacts (handover/recovery loop).
# The skill (.claude/skills/), hooks (.claude/hooks/), and committed settings
# (.claude/settings.json) ARE tracked; these per-session files are NOT.
# Consumed handovers in archive/handovers/ ARE tracked for history.
.claude/handovers/
.codex/handovers/
.checkpoint
.claude/session-errors.jsonl
.claude/error-history.jsonl
.claude/settings.local.json
.claude/sessions/
.claude/.session-id

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Per-session OpenCode fleet configuration (machine-specific paths, plugin refs).
# The fleet envelope and spike policy are in the opum-doc repository.
opencode.jsonc

# Lore agent profile definitions (generated by `lore agents`; per-session specialist configs).
.lore/agents/

# Repository-local tracker-cutover evidence (never published, never committed).
.lore/archive/
.lore/cutover/

# npm pack output landing in the REPOSITORY ROOT. `dist-npm/` above covers the release
# workflow's own destination; this covers the case that bit us. `npm pack` writes into the
# CURRENT directory, so a pack run from the root leaves a tarball where `git add -A` would
# commit it — which nearly happened on 2026-08-29, when a stray `npm pack .` left
# opum-ai-lore-0.3.5.tgz in the root mid-commit. Release tarballs are large build output and
# a committed one is a second, unverified copy of a release artifact.
*.tgz
